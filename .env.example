# PaperGuard 本地 secrets 示例 — 复制为 .env 并填入真实值(.env 已被 gitignore)
# 系统内置 AI 模型(OpenAI 兼容协议, 全体用户默认可用)
#PAPERGUARD_AI_BASE_URL=https://api.deepseek.com
#PAPERGUARD_AI_API_KEY=sk-xxx
#PAPERGUARD_AI_MODEL=deepseek-v4-flash
# 可选: AI 请求超时秒数(默认 60)
#PAPERGUARD_AI_TIMEOUT=60
# 小程序服务端参数（仅在受控 secrets 管理中填入真实值）
#PAPERGUARD_WECHAT_APP_ID=wx-example
#PAPERGUARD_WECHAT_APP_SECRET=secret-from-wechat-console
#PAPERGUARD_MP_BINDING_SECRET=independent-random-binding-secret

# Resend 邮件发送(邮箱注册验证码, 推荐; 配置后优先于 SMTP)
# 沙箱模式(未验证域名)只能发给 Resend 账号所有者邮箱; 生产需验证发信域名
# PAPERGUARD_RESEND_API_KEY=re_xxxxxxxxxxxx
# PAPERGUARD_RESEND_FROM=noreply@your-domain.com
