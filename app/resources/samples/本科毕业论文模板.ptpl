{
  "version": "1.0",
  "metadata": {
    "name": "本科毕业论文模板",
    "author": "系统内置",
    "description": "适用于本科毕业论文的标准模板。包含封面、中英文摘要、目录、正文（5章）、参考文献、致谢等完整结构。"
  },
  "format_config": {
    "page_setup": {
      "paper_size": "A4",
      "width_cm": 21.0,
      "height_cm": 29.7,
      "margin_top_cm": 2.54,
      "margin_bottom_cm": 2.54,
      "margin_left_cm": 3.17,
      "margin_right_cm": 3.17,
      "header_margin_cm": 1.5,
      "footer_margin_cm": 1.75,
      "orientation": "portrait"
    },
    "styles": {
      "cover_title": {
        "style_id": "cover_title",
        "font": {
          "name_cn": "黑体",
          "name_en": "Times New Roman",
          "size_pt": 22.0,
          "bold": true,
          "italic": false,
          "color_hex": "000000"
        },
        "paragraph": {
          "alignment": "center",
          "line_spacing": 2.0,
          "space_before_pt": 0,
          "space_after_pt": 0,
          "first_line_indent_cm": 0,
          "left_indent_cm": 0,
          "right_indent_cm": 0
        }
      },
      "heading_1": {
        "style_id": "heading_1",
        "font": {
          "name_cn": "黑体",
          "name_en": "Times New Roman",
          "size_pt": 16.0,
          "bold": true,
          "italic": false,
          "color_hex": "000000"
        },
        "paragraph": {
          "alignment": "center",
          "line_spacing": 1.5,
          "space_before_pt": 12,
          "space_after_pt": 6,
          "first_line_indent_cm": 0,
          "left_indent_cm": 0,
          "right_indent_cm": 0
        }
      },
      "heading_2": {
        "style_id": "heading_2",
        "font": {
          "name_cn": "黑体",
          "name_en": "Times New Roman",
          "size_pt": 14.0,
          "bold": true,
          "italic": false,
          "color_hex": "000000"
        },
        "paragraph": {
          "alignment": "left",
          "line_spacing": 1.5,
          "space_before_pt": 8,
          "space_after_pt": 4,
          "first_line_indent_cm": 0,
          "left_indent_cm": 0,
          "right_indent_cm": 0
        }
      },
      "heading_3": {
        "style_id": "heading_3",
        "font": {
          "name_cn": "黑体",
          "name_en": "Times New Roman",
          "size_pt": 13.0,
          "bold": true,
          "italic": false,
          "color_hex": "000000"
        },
        "paragraph": {
          "alignment": "left",
          "line_spacing": 1.5,
          "space_before_pt": 6,
          "space_after_pt": 3,
          "first_line_indent_cm": 0,
          "left_indent_cm": 0,
          "right_indent_cm": 0
        }
      },
      "body_text": {
        "style_id": "body_text",
        "font": {
          "name_cn": "宋体",
          "name_en": "Times New Roman",
          "size_pt": 12.0,
          "bold": false,
          "italic": false,
          "color_hex": "000000"
        },
        "paragraph": {
          "alignment": "justify",
          "line_spacing": 1.5,
          "space_before_pt": 0,
          "space_after_pt": 0,
          "first_line_indent_cm": 0.74,
          "left_indent_cm": 0,
          "right_indent_cm": 0
        }
      }
    },
    "header_text": "",
    "footer_text": ""
  },
  "structure": [
    {
      "id": "cover",
      "label": "封面",
      "type": "cover",
      "required": true,
      "auto_generate": false,
      "style_id": "body_text",
      "description": "自动生成，包含论文标题、作者、学号、专业、导师等信息"
    },
    {
      "id": "abstract_cn",
      "label": "中文摘要",
      "type": "abstract",
      "required": true,
      "auto_generate": false,
      "style_id": "body_text",
      "description": "简要概括论文的研究背景、目的、方法、结果和结论，300字左右"
    },
    {
      "id": "abstract_en",
      "label": "英文摘要",
      "type": "abstract",
      "required": false,
      "auto_generate": false,
      "style_id": "body_text",
      "description": "中文摘要的英文翻译，关键词需对应"
    },
    {
      "id": "toc",
      "label": "目录",
      "type": "toc",
      "required": true,
      "auto_generate": true,
      "style_id": "body_text",
      "description": "自动生成目录，在 Word 中更新域即可"
    },
    {
      "id": "chapter_1",
      "label": "第1章 绪论",
      "type": "chapter",
      "required": true,
      "auto_generate": false,
      "style_id": "heading_1",
      "description": "介绍研究背景、研究意义、国内外研究现状",
      "subsections": [
        {
          "id": "ch1_sec1",
          "label": "1.1 研究背景",
          "type": "section",
          "required": false,
          "auto_generate": false,
          "style_id": "heading_2",
          "description": ""
        },
        {
          "id": "ch1_sec2",
          "label": "1.2 研究意义",
          "type": "section",
          "required": false,
          "auto_generate": false,
          "style_id": "heading_2",
          "description": ""
        },
        {
          "id": "ch1_sec3",
          "label": "1.3 国内外研究现状",
          "type": "section",
          "required": false,
          "auto_generate": false,
          "style_id": "heading_2",
          "description": ""
        }
      ]
    },
    {
      "id": "chapter_2",
      "label": "第2章 相关技术介绍",
      "type": "chapter",
      "required": true,
      "auto_generate": false,
      "style_id": "heading_1",
      "description": "介绍论文涉及的核心技术和理论",
      "subsections": []
    },
    {
      "id": "chapter_3",
      "label": "第3章 系统设计与实现",
      "type": "chapter",
      "required": true,
      "auto_generate": false,
      "style_id": "heading_1",
      "description": "详细描述系统的设计和实现过程",
      "subsections": []
    },
    {
      "id": "chapter_4",
      "label": "第4章 实验结果与分析",
      "type": "chapter",
      "required": true,
      "auto_generate": false,
      "style_id": "heading_1",
      "description": "展示实验结果并进行详细分析",
      "subsections": []
    },
    {
      "id": "chapter_5",
      "label": "第5章 总结与展望",
      "type": "chapter",
      "required": true,
      "auto_generate": false,
      "style_id": "heading_1",
      "description": "总结论文工作，指出不足和未来方向",
      "subsections": []
    },
    {
      "id": "references",
      "label": "参考文献",
      "type": "references",
      "required": true,
      "auto_generate": false,
      "style_id": "body_text",
      "description": "列出论文引用的所有参考文献，按引用顺序编号"
    },
    {
      "id": "acknowledgements",
      "label": "致谢",
      "type": "acknowledgements",
      "required": true,
      "auto_generate": false,
      "style_id": "heading_1",
      "description": "感谢指导教师、同学和家人的支持"
    }
  ]
}
